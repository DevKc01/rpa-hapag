os.querySelectorAll('.hal-event')).map(function (card) {&#xA;      var micro = card.querySelectorAll('.hal-micro-data__content');&#xA;      var itens = card.querySelectorAll('.hal-data-item__content');&#xA;      return {&#xA;        status: texto(micro[0]),&#xA;        local: texto(card.querySelector('.hal-event__title')),&#xA;        data: texto(micro[1]),&#xA;        hora: texto(itens[0]),&#xA;        transporte: texto(itens[1]),&#xA;        viagem: texto(itens[2])&#xA;      };&#xA;    });&#xA;  };&#xA;  linhas.forEach(function (tr) {&#xA;    var tds = tr.querySelectorAll(':scope &gt; td');&#xA;    if (tds.length &lt; 6) { return; }&#xA;    var container = texto(tds[0]).replace(/\s+/g, '');&#xA;    var pendente = (container === '-');&#xA;    if (!pendente &amp;&amp; !padraoContainer.test(container)) { return; }&#xA;    if (pendente) { container = ''; }&#xA;    var eventos = lerEventos(tr.nextElementSibling);&#xA;    var ultimo = texto(tds[4]);&#xA;    var dataHora = '';&#xA;    var status = '';&#xA;    var local = '';&#xA;    if (ultimo === '-') { ultimo = ''; }&#xA;    var m = /^(.*?)\s+on\s+(\d{4}-\d{2}-\d{2}(?:\s+\d{2}:\d{2})?)$/.exec(ultimo);&#xA;    if (m) {&#xA;      dataHora = m[2];&#xA;      var dia = dataHora.slice(0, 10);&#xA;      var hora = dataHora.slice(11);&#xA;      var card = eventos.filter(function (e) {&#xA;        return e.data === dia &amp;&amp; (!hora || e.hora === hora) &amp;&amp; ultimo.indexOf(e.status) === 0 &amp;&amp; ultimo.indexOf(e.local) &gt; -1;&#xA;      })[0];&#xA;      if (card) {&#xA;        status = card.status;&#xA;        local = card.local;&#xA;      } else {&#xA;        var sep = /^(.*?)\s+([A-Z0-9][A-Z0-9 .,'\-\/()]*)$/.exec(m[1]);&#xA;        status = sep ? sep[1] : m[1];&#xA;        local = sep ? sep[2] : '';&#xA;      }&#xA;    } else {&#xA;      status = ultimo;&#xA;    }&#xA;    resultado.containers.push({&#xA;      tipo: texto(tds[3]),&#xA;      container: container,&#xA;      status: status,&#xA;      data: dataHora,&#xA;      local: local&#xA;    });&#xA;    if (eventos.length &gt; 0) {&#xA;      if (!container &amp;&amp; !eventosPendentes.length) { eventosPendentes = eventos; }&#xA;      if (container &amp;&amp; !resultado.eventos.length) { resultado.eventos = eventos; }&#xA;    }&#xA;  });&#xA;  if (!resultado.eventos.length) { resultado.eventos = eventosPendentes; }&#xA;  return JSON.stringify(resultado);&#xA;}" sap2010:WorkflowViewState.IdRef="NInjectJsScript_201"><uix:NInjectJsScript.ScriptOutput><OutArgument x:TypeArguments="x:String"><CSharpReference x:TypeArguments="x:String" sap2010:WorkflowViewState.IdRef="CSharpReference`1_202">jsonTracking</CSharpReference></OutArgument></uix:NInjectJsScript.ScriptOutput><uix:NInjectJsScript.Target><uix:TargetAnchorable BrowserURL="hapag-lloyd.com/solutions/tracking" ElementVisibilityArgument="Interactive" FullSelectorArgument="&lt;webctrl tag='MAIN' id='appContent' /&gt;" Guid="bbb91ff6-8317-4191-b6d0-d956398f9773" ScopeSelectorArgument="&lt;html app='msedge.exe' title='Tracking | Hapag-Lloyd' /&gt;" SearchSteps="Selector" Version="V6" WaitForReadyArgument="Interactive" /></uix:NInjectJsScript.Target></uix:NInjectJsScript><Assign sap2010:WorkflowViewState.IdRef="Assign_204"><Assign.To><OutArgument x:TypeArguments="x:Boolean"><CSharpReference x:TypeArguments="x:Boolean" sap2010:WorkflowViewState.IdRef="CSharpReference`1_205">pronto</CSharpReference></OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="x:Boolean"><CSharpValue x:TypeArguments="x:Boolean" sap2010:WorkflowViewState.IdRef="CSharpValue`1_206">!string.IsNullOrWhiteSpace(jsonTracking) &amp;&amp; jsonTracking.Contains("\"container\":") &amp;&amp; jsonTracking != jsonAnterior</CSharpValue></InArgument></Assign.Value></Assign></Sequence></If.Then></If></ActivityAction></ui:ForEach.Body><ui:ForEach.Values><InArgument x:TypeArguments="sc:IEnumerable"><CSharpValue x:TypeArguments="sc:IEnumerable" sap2010:WorkflowViewState.IdRef="CSharpValue`1_211">new List&lt;int